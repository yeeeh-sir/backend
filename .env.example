# AI ASSISTANT CONFIGURATION
AI_API_KEY=your_openai_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# GOOGLE GEMINI AI CONFIGURATION (REQUIRED)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# GOOGLE ANALYTICS 4 REPORTING (server-side Admin analytics only)
# GA4 property numeric ID, not the browser measurement ID G-J25JBHTZ8D.
GA4_PROPERTY_ID=your_ga4_property_id
# Render-friendly service-account variables. Keep these backend-only secrets.
GOOGLE_CLIENT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY=your_service_account_private_key_with_escaped_newlines
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json,
# or provide the JSON directly through the backend secret below.
# GA4_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}

# DATABASE CONFIGURATION (Aiven MySQL)
DB_HOST=your_db_host_here
DB_PORT=3306
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# Maximum number of connections in the MySQL pool (default: 10)
# Use 2-4 per Node instance when running multiple instances behind a load balancer
DB_CONNECTION_LIMIT=10

# CACHE CONFIGURATION
# Enabled by default. Set CACHE_ENABLED=false to disable all server-side caching.
CACHE_ENABLED=true

# Redis store is optional. Leave REDIS_URL empty to use the in-memory cache
# (per-instance, loses data on restart). Set REDIS_URL when running multiple
# instances behind a load balancer. Requires ioredis: npm install ioredis
# REDIS_URL=redis://username:password@your_redis_host:6379

# Cache TTLs (seconds) for public read endpoints
CACHE_TTL_POSTS_LIST=30
CACHE_TTL_POST_DETAIL=600
CACHE_TTL_CATEGORIES=600
CACHE_TTL_CATEGORY_DETAIL=300
CACHE_TTL_ADS=120
CACHE_TTL_SITEMAP=300

# API CONFIGURATION
# Max number of latest approved posts returned to the public /api/posts (default: 200)
# Bounds payload size on high-traffic pages when pagination is not used.
PUBLIC_POSTS_LIMIT=200

# Per-instance public API rate limit: max requests per 60 seconds per IP (default: 600).
# Raise this only if a specific page makes excessive requests. Counters are per-instance,
# so behind a load balancer the effective limit scales with the number of instances.
PUBLIC_RATE_LIMIT_MAX=600

# CLOUDINARY CONFIGURATION
# Do NOT commit real credentials to Git
# Get these from your Cloudinary account: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# NOTE:
# - Copy this file to .env and fill in your actual credentials
# - The .env file is ignored by Git (.gitignore) - never commit it
# - Keep API keys and passwords secret and only in the .env file
# - Use the same credentials for both local development and production
