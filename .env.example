# AI ASSISTANT CONFIGURATION
AI_API_KEY=your_openai_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# DATABASE CONFIGURATION (Aiven MySQL)
DB_HOST=your_db_host_here
DB_PORT=3306
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# CLOUDINARY CONFIGURATION
# Do NOT commit real credentials to Git
# Get these from your Cloudinary account: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# NOTE:
# - Copy this file to .env and fill in your actual credentials
# - The .env file is ignored by Git (.gitignore) - never commit it
# - Keep API keys and passwords secret and only in the .env file
# - Use the same credentials for both local development and production
